# Copy to .env locally. Never commit .env or other secrets.

# API
CLAIMSIGHT_ENV=dev
CLAIMSIGHT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_AUTH=true

# LLM — auto uses Anthropic when keyed, else deterministic graph reasoner
CLAIMSIGHT_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAIMSIGHT_MODEL_NAME=claude-sonnet-4-5
CLAIMSIGHT_PROMPT_VERSION=2026-08-31.1

# Persistence (SQLite works without Docker)
DATABASE_URL=sqlite+pysqlite:///./claimsight.db

# Compose / later cloud
# DATABASE_URL=postgresql+psycopg://claimsight:claimsight@localhost:5432/claimsight
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=claimsight-dev
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage (MinIO locally, S3/GCS later)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=claimsight
S3_SECRET_KEY=claimsight-secret
S3_BUCKET=claimsight-docs
S3_REGION=us-east-1

# Cost cap (simulated tokens per claim before forced HITL)
CLAIMSIGHT_TOKEN_BUDGET=8000
CLAIMSIGHT_HIGH_VALUE_USD=50000

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
SENTRY_DSN=
